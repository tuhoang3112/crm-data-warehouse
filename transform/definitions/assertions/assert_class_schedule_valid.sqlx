config {
  type: "assertion",
  description: "Class schedule sheet: class_code is unique and every class has a start date (fact_deal.class_code joins on class_code)"
}

-- The sheet is edited by hand, so duplicates or missing dates can appear at any time.
SELECT class_code, 'duplicate_class_code' AS issue
FROM ${ref("dim_class_schedule")}
GROUP BY class_code
HAVING COUNT(*) > 1

UNION ALL

SELECT class_code, 'missing_class_start_date' AS issue
FROM ${ref("dim_class_schedule")}
WHERE class_start_date IS NULL
