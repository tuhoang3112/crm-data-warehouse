config {
  type: "table",
  schema: "dm_rework_crm",
  description: "Fact: one row per deal activity (note, call, changelog...)",
  assertions: {
    uniqueKey: ["activity_id"],
    nonNull: ["activity_id", "deal_id", "created_at"]
  }
}

SELECT
  activity_id,
  deal_id,                    -- FK to fact_deal
  activity_type_label AS activity_type,
  activity_content,
  owner_user_id,               -- FK to dim_user
  created_at,
  updated_at
FROM ${ref("stg_deal_activity")}
