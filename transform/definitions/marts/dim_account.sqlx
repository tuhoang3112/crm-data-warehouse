config {
  type: "table",
  schema: "dm_rework_crm",
  description: "Dimension: customer companies/accounts",
  assertions: {
    uniqueKey: ["account_id"],
    nonNull: ["account_id"]
  }
}

SELECT
  account_id,
  account_name,
  address_raw AS account_address,
  account_content AS account_description,
  brand_name,
  industry,
  website,
  linkedin_profile,
  company_size,
  created_at,
  updated_at
FROM ${ref("stg_account")}
