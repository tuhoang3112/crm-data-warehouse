config {
  type: "view",
  schema: "dm_rework_crm_view",
  description: "Staging: pipeline stages"
}

SELECT

  -- Identifiers
  id AS stage_id,
  pipeline_id,                    -- FK to stg_pipeline

  -- Text fields
  name AS stage_name,

  REGEXP_REPLACE(
    REGEXP_REPLACE(
      REGEXP_REPLACE(content, r'<[^>]+>', ' '),
      r'&amp;', '&'
    ),
    r'\s+', ' '
  ) AS stage_content,

  color AS stage_color,

  -- Numeric / status fields
  status AS stage_status,
  real_order AS stage_order,
  user_id AS owner_user_id,       -- FK to user
  prob AS win_probability,
  rotting AS rotting_days,
  use_rotting,

  -- Arrays (kept as raw JSON, UNNEST when needed)
  owners,
  followers,

  -- Timestamps (unix timestamp -> local time, Asia/Bangkok)
  DATETIME(TIMESTAMP_SECONDS(SAFE_CAST(since AS INT64)), 'Asia/Bangkok') AS created_at,
  DATETIME(TIMESTAMP_SECONDS(SAFE_CAST(last_update AS INT64)), 'Asia/Bangkok') AS updated_at,

  -- Metadata
  _airbyte_extracted_at

FROM ${ref("stage")}

QUALIFY ROW_NUMBER() OVER (
  PARTITION BY id
  ORDER BY _airbyte_extracted_at DESC
) = 1
