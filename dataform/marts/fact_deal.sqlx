config {
  type: "table",
  schema: "dm_rework_crm",
  description: "Fact: giao dịch/deal trong pipeline bán hàng"
}

SELECT
  sd.deal_id,
  dc.contact_key,
  sd.stage_id,
  sd.owner_user_id,
  sd.deal_name,
  sd.deal_status,
  sd.labels,
  sd.is_alumni,
  sd.group_registration,
  sd.course_selected,
  sd.learning_format,
  sd.class_code,
  sd.expectation,
  sd.promotion_code,
  sd.gift,
  sd.need_consulting,
  sd.preferred_consulting_time,
  sd.pain_point_captured,
  sd.pending_reason,
  sd.pending_reason_detail,
  sd.has_followup_plan,
  sd.next_step,
  sd.lost_reason,
  sd.lost_reason_detail,
  sd.utm_source,
  sd.utm_medium,
  sd.utm_content,
  sd.utm_product,
  sd.utm_person,
  sd.created_at,
  sd.updated_at,
  sd.closed_at
FROM ${ref("stg_deal")} sd
LEFT JOIN ${ref("dim_contact")} dc
  ON sd.contact_id = dc.contact_id
  AND sd.created_at >= dc.effective_date
  AND sd.created_at < COALESCE(dc.end_date, '9999-12-31')
